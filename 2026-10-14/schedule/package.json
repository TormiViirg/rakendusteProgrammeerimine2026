{
  "name": "poff-shift-cards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "tsc -b && oxlint && vitest run",
    "check:layout": "node scripts/check-layout.mjs",
    "docs": "WRITE_DOCS=1 vitest run tests/docs"
  },
  "dependencies": {
    "@fontsource/fira-mono": "^5.3.0",
    "@fontsource/fira-sans-condensed": "^5.3.0",
    "@fontsource/fira-sans-extra-condensed": "^5.3.0",
    "i18next": "^26.4.2",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.56.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
